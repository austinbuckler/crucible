{
  "name": "react-crucible",
  "version": "0.0.1",
  "description": "Crucible's vite plugin + runtime for routes, codegen, PWA, and Electron integration. Open-source-bound; no react-* dependencies.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./crucible": "./crucible.ts",
    "./crucible-env": "./crucible-env.d.ts",
    "./cli": "./cli.ts",
    "./preflight": "./preflight.ts",
    "./pwa": "./pwa.ts",
    "./sw": "./sw.ts",
    "./electron": "./electron/main.ts",
    "./electron/preload": "./electron/preload.ts",
    "./runtime/*": "./runtime/*",
    "./codegen/*": "./codegen/*",
    "./ui/*": "./ui/*"
  },
  "bin": {
    "crucible-codegen": "./cli.ts",
    "crucible-preflight": "./preflight.ts"
  },
  "scripts": {
    "codegen": "bun ./cli.ts",
    "preflight": "bun ./preflight.ts",
    "test": "bun test",
    "build": "true",
    "lint": "true",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "graphql": "^16.14.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.2",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.2",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^42.4.0",
    "fast-check": "^4.8.0",
    "graphql": "^16.14.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^6.1.2",
    "react-relay": "^21.0.1",
    "relay-runtime": "^21.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
